# Copy this file to .env and edit before hosting the event.
# The server reads these as plain environment variables (no extra
# package required) — on most hosts you'll set them in a dashboard
# instead of a file. If you do use a .env file locally, load it with
# `node --env-file=.env server.js` (Node 20+) or your host's standard method.

# Password staff use to open /admin.html
ADMIN_PASSWORD=lamour2026

# Long random string used to sign admin login sessions — change this
# for real deployments.
SESSION_SECRET=change-this-to-something-random

# MongoDB connection string for persistent spin log storage
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas/register
# Format: mongodb+srv://username:password@cluster.mongodb.net/wheel-of-love?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/wheel-of-love

# Port the server listens on
PORT=3000
